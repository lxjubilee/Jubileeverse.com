# Environment Configuration
NODE_ENV=development

# Server Configuration
PORT=3107
HOST=0.0.0.0

# InspireCodex API (content backend)
INSPIRE_API_BASE=https://inspirecodex.com/api/v1

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Signing secret for the local access token. MUST be set — without it server.js
# falls back to a committed literal. 32+ random bytes:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Dev auth bypass for GET /auth/login. DANGER: when true that route renders a
# form that upserts ANY email as role `admin` with no password. Local dev only.
LOCAL_AUTH_ENABLED=false

# Public origin of this site (controls the __Host- cookie prefix + Secure flag).
APP_BASE_URL=https://jubileeverse.com
# CORS allow-list, comma separated.
ALLOWED_ORIGINS=https://jubileeverse.com,https://www.jubileeverse.com

# ---- Single Sign-On (Jubilee Identity Authority) ---------------------------
# 'local' — verify email/password against jv_users in our own DB.
# 'sso'   — delegate to sso.jubileeinspire.com: it holds the shared scrypt
#           credential; we verify there, upsert the returned user locally, and
#           mint our OWN session tokens (we stay the session + role authority).
# Rollback is "set back to 'local' + restart" — no redeploy.
AUTH_LOGIN_MODE=local
SSO_API_BASE=https://sso.jubileeinspire.com
SSO_CLIENT_ID=jubileeverse
# Issued by the Identity Authority operator. Empty => SSO disabled, login stays
# on the local path regardless of AUTH_LOGIN_MODE.
SSO_CLIENT_SECRET=
SSO_SITE=jubileeverse
SSO_TIMEOUT_MS=8000

# ── Transactional email ─────────────────────────────────────────────────────
# Password reset is the only user-facing flow that depends on this, and it
# fails quietly without it: the request is accepted, the token is written, and
# no mail is ever sent. With none of the below set the server logs
# "[email] DISABLED" at boot and refuses to pretend otherwise.
#
# Primary credentials. Port 465 is treated as implicit TLS, anything else as
# STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Must be an address the provider is authorised to send for — a mismatch is a
# common cause of credentials being accepted and the message then rejected.
SMTP_FROM=noreply@jubileeverse.com

# Amazon SES, used only when SMTP_HOST above is empty.
SES_SMTP_ENDPOINT=
SES_SMTP_PORT=587
SES_SMTP_USERNAME=
SES_SMTP_PASSWORD=

# Where the reset link points. This is the public Next.js origin, NOT
# APP_BASE_URL, which addresses this Express process and 404s on
# /reset-password. Unset, the link falls back to APP_BASE_URL and then to the
# request host, which behind the reverse proxy is the internal hostname — a
# link the recipient cannot open.
PUBLIC_WEB_URL=https://jubileeverse.com
